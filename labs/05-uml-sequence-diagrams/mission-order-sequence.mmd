%%{init: {'sequence': {'mirrorActors': false}}}%%
sequenceDiagram
    participant Client
    participant Order
    participant OrderValidator
    participant Portfolio
    participant Instrument
    participant OrderProcessor
    participant SettlementReport

    Client ->> +Order: new Order(instrument, quantity, price, side)
    Order -->> -Client: order

    Client ->> +OrderProcessor: process(order, portfolio)
    OrderProcessor ->> +OrderValidator: validate(order, portfolio)
    OrderValidator ->> +Portfolio: getHolding(instrument)
    Portfolio -->> -OrderValidator: holding
    OrderValidator ->> +Portfolio: totalValue()
    Portfolio -->> -OrderValidator: totalValue
    OrderValidator -->> -OrderProcessor: isValid

    alt order is valid
        OrderProcessor ->> +Instrument: calculateFee(order.getValue())
        Instrument -->> -OrderProcessor: fee
        OrderProcessor ->> +Portfolio: getHolding(instrument)
        Portfolio -->> -OrderProcessor: holding
        OrderProcessor ->> +Order: accept()
        Order -->> -OrderProcessor: ok
        OrderProcessor ->> +SettlementReport: add(order)
        SettlementReport -->> -OrderProcessor: ok
    else order is invalid
        OrderProcessor ->> +Order: reject(reason)
        Order -->> -OrderProcessor: ok
        OrderProcessor ->> +SettlementReport: add(order)
        SettlementReport -->> -OrderProcessor: ok
    end

    OrderProcessor -->> -Client: done
    Client ->> +SettlementReport: produce()
    SettlementReport -->> -Client: report
